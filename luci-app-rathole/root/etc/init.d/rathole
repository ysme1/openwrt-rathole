#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

BIN="/usr/bin/rathole"
CONFIG_DIR="/var/etc"
SERVER_TOML="$CONFIG_DIR/rathole_server.toml"
CLIENT_TOML="$CONFIG_DIR/rathole_client.toml"

generate_server_toml() {
	local bind_addr default_token heartbeat_interval transport nodelay
	config_get bind_addr "server" bind_addr "0.0.0.0:2333"
	config_get default_token "server" default_token
	config_get heartbeat_interval "server" heartbeat_interval "30"
	config_get transport "server" transport "tcp"
	config_get_bool nodelay "server" nodelay 1

	mkdir -p "$CONFIG_DIR"
	cat <<EOF > "$SERVER_TOML"
# Auto-generated by /etc/init.d/rathole. Do not edit.

[server]
bind_addr = "$bind_addr"
EOF
	[ -n "$default_token" ] && echo "default_token = \"$default_token\"" >> "$SERVER_TOML"
	[ -n "$heartbeat_interval" ] && echo "heartbeat_interval = $heartbeat_interval" >> "$SERVER_TOML"

	cat <<EOF >> "$SERVER_TOML"

[server.transport]
type = "$transport"

[server.transport.tcp]
nodelay = $([ "$nodelay" = "1" ] && echo "true" || echo "false")
EOF

	append_server_service() {
		local s="$1"
		local name bind_addr token type svc_nodelay
		config_get name "$s" name
		config_get bind_addr "$s" bind_addr
		config_get token "$s" token
		config_get type "$s" type "tcp"
		config_get_bool svc_nodelay "$s" nodelay 1

		[ -z "$name" ] || [ -z "$bind_addr" ] && return 0

		cat <<EOF >> "$SERVER_TOML"

[server.services.$name]
bind_addr = "$bind_addr"
type = "$type"
nodelay = $([ "$svc_nodelay" = "1" ] && echo "true" || echo "false")
EOF
		[ -n "$token" ] && echo "token = \"$token\"" >> "$SERVER_TOML"
	}

	config_foreach append_server_service "server_service"
}

generate_client_toml() {
	local remote_addr default_token heartbeat_timeout retry_interval transport nodelay proxy
	config_get remote_addr "client" remote_addr
	config_get default_token "client" default_token
	config_get heartbeat_timeout "client" heartbeat_timeout "40"
	config_get retry_interval "client" retry_interval "1"
	config_get transport "client" transport "tcp"
	config_get_bool nodelay "client" nodelay 1
	config_get proxy "client" proxy

	if [ -z "$remote_addr" ]; then
		logger -t rathole "Error: Client remote_addr is empty!"
		return 1
	fi

	mkdir -p "$CONFIG_DIR"
	cat <<EOF > "$CLIENT_TOML"
# Auto-generated by /etc/init.d/rathole. Do not edit.

[client]
remote_addr = "$remote_addr"
EOF
	[ -n "$default_token" ] && echo "default_token = \"$default_token\"" >> "$CLIENT_TOML"
	[ -n "$heartbeat_timeout" ] && echo "heartbeat_timeout = $heartbeat_timeout" >> "$CLIENT_TOML"
	[ -n "$retry_interval" ] && echo "retry_interval = $retry_interval" >> "$CLIENT_TOML"

	cat <<EOF >> "$CLIENT_TOML"

[client.transport]
type = "$transport"

[client.transport.tcp]
nodelay = $([ "$nodelay" = "1" ] && echo "true" || echo "false")
EOF
	[ -n "$proxy" ] && echo "proxy = \"$proxy\"" >> "$CLIENT_TOML"

	append_client_service() {
		local s="$1"
		local name local_addr token type svc_nodelay svc_retry
		config_get name "$s" name
		config_get local_addr "$s" local_addr
		config_get token "$s" token
		config_get type "$s" type "tcp"
		config_get_bool svc_nodelay "$s" nodelay 1
		config_get svc_retry "$s" retry_interval

		[ -z "$name" ] || [ -z "$local_addr" ] && return 0

		cat <<EOF >> "$CLIENT_TOML"

[client.services.$name]
local_addr = "$local_addr"
type = "$type"
nodelay = $([ "$svc_nodelay" = "1" ] && echo "true" || echo "false")
EOF
		[ -n "$token" ] && echo "token = \"$token\"" >> "$CLIENT_TOML"
		[ -n "$svc_retry" ] && echo "retry_interval = $svc_retry" >> "$CLIENT_TOML"
	}

	config_foreach append_client_service "client_service"
	return 0
}

start_service() {
	local enabled role log_level
	config_load rathole
	config_get_bool enabled "common" enabled 0
	config_get role "common" role "both"
	config_get log_level "common" log_level "info"

	if [ "$enabled" -ne 1 ]; then
		logger -t rathole "Service is disabled in UCI configuration"
		return 0
	fi

	if [ ! -x "$BIN" ]; then
		local err_msg="Binary $BIN not found or not executable. Please install rathole."
		logger -s -t rathole "$err_msg"
		return 1
	fi

	# 启动 Server 实例
	if [ "$role" = "server" ] || [ "$role" = "both" ]; then
		generate_server_toml
		procd_open_instance "server"
		procd_set_param command "$BIN" --server "$SERVER_TOML"
		procd_set_param env RUST_LOG="$log_level"
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		logger -t rathole "Started rathole server instance"
	fi

	# 启动 Client 实例
	if [ "$role" = "client" ] || [ "$role" = "both" ]; then
		if generate_client_toml; then
			procd_open_instance "client"
			procd_set_param command "$BIN" --client "$CLIENT_TOML"
			procd_set_param env RUST_LOG="$log_level"
			procd_set_param respawn 3600 5 0
			procd_set_param stdout 1
			procd_set_param stderr 1
			procd_close_instance
			logger -t rathole "Started rathole client instance"
		else
			logger -t rathole "Failed to generate client config, client instance aborted"
		fi
	fi
}

stop_service() {
	rm -f "$SERVER_TOML" "$CLIENT_TOML"
}

service_triggers() {
	procd_add_reload_trigger "rathole"
}
